{
  "name": "litespeed",
  "version": "0.1.0",
  "description": "A lightweight, modular web proxy: static frontend for GitHub Pages plus a portable fetch-API backend.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:sw": "node scripts/build-sw.mjs",
    "build:web": "node scripts/build-sw.mjs && node scripts/build-web.mjs",
    "test": "node --test",
    "test:browser": "node scripts/browser-test.mjs",
    "smoke": "node scripts/sites-smoke.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "bench:h2": "node scripts/h2-bench.mjs",
    "bench": "node scripts/bench.mjs",
    "deploy:worker": "wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "undici": "^7.30.0",
    "ws": "^8.22.0"
  }
}
