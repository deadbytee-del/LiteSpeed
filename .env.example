# Backend (Node adapter / Docker). On Cloudflare set these as [vars] in wrangler.toml.
PORT=8787
HOST=127.0.0.1
LITESPEED_ALLOWED_ORIGINS=*          # comma list, e.g. https://you.github.io
LITESPEED_TIMEOUT_MS=20000
LITESPEED_CACHE=on                   # on | off
LITESPEED_REWRITE_JS=off             # on = rewrite absolute ES-module import specifiers
LITESPEED_BLOCKED_HOSTS=             # comma list of host suffixes
LITESPEED_ALLOWED_HOSTS=             # if set, ONLY these host suffixes are proxied
LITESPEED_ALLOW_PRIVATE=off          # on = allow private/loopback targets (never on a public deployment)

# Frontend build (scripts/build-web.mjs)
LITESPEED_API_URL=                   # e.g. https://litespeed-api.you.workers.dev
