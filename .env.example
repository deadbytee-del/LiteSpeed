# ---- Backend (Node adapter / Docker). On Cloudflare Workers set these as [vars] in wrangler.toml. ----
PORT=8787
HOST=127.0.0.1                      # use 0.0.0.0 in containers
LITESPEED_ALLOWED_ORIGINS=*         # comma list, e.g. https://you.github.io  (set this in production)
LITESPEED_TIMEOUT_MS=20000          # wait for upstream response headers
LITESPEED_CACHE=on                  # on | off   (server-rewrite mode cache; the service worker has its own)
LITESPEED_ADBLOCK=on                # ad/tracker blocking in server-rewrite mode
LITESPEED_REWRITE_JS=on             # server-rewrite mode: token-level JS rewrite (location/top/parent/postMessage/imports)
LITESPEED_BLOCKED_HOSTS=            # comma list of host suffixes
LITESPEED_ALLOWED_HOSTS=            # if set, ONLY these host suffixes are proxied
LITESPEED_ALLOW_PRIVATE=off         # on = allow private/loopback targets (never on a public deployment)

# ---- Load handling (Node) ----
LITESPEED_WORKERS=auto              # cluster workers: auto (= CPUs, max 4) or a number; 1 disables clustering
LITESPEED_MAX_INFLIGHT=0            # per-worker cap on concurrent proxied requests; over it -> fast 503 (0 = unlimited)
LITESPEED_RATE_LIMIT=0              # per-client requests/second (token bucket, burst 2x); over it -> 429 (0 = off)
LITESPEED_TRUST_PROXY=off           # honour X-Forwarded-For/Proto/Host behind a reverse proxy

# ---- Transport (Node) ----
LITESPEED_TLS_KEY=                  # PEM paths: enable HTTP/2 (+ HTTP/1.1 fallback) directly on the Node server
LITESPEED_TLS_CERT=
LITESPEED_UPSTREAM_PROXY=           # http(s) proxy for all outbound traffic (egress proxies)

# ---- Frontend build (scripts/build-web.mjs) ----
LITESPEED_API_URL=                  # relay URL(s), comma-separated for failover, e.g. https://litespeed-api.you.workers.dev
